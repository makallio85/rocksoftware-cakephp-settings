{
    "name": "makallio85/rocksoftware-cakephp-settings",
    "description": "CakePHP 5 plugin with one settings store and one settings page for a Rock Software application: settings declared in code, values in the database with their change history.",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "settings", "configuration"],
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "cakephp/cakephp": "^5.2",
        "cakephp/migrations": "^4.0 || ^5.0"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "RockSoftware\\Settings\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RockSoftware\\Settings\\Test\\": "tests/",
            "TestApp\\": "tests/test_app/src/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "cs-check": "phpcs --colors -p src/ tests/ templates/",
        "cs-fix": "phpcbf --colors -p src/ tests/ templates/",
        "stan": "phpstan analyse --memory-limit=512M"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "cakephp/plugin-installer": true
        }
    }
}
